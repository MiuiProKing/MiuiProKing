LUCKYJET_HISTORY_URL=https://crash-gateway-grm-cr.100hp.app/history
LUCKYJET_CUSTOMER_ID=replace_me
LUCKYJET_SESSION_ID=replace_me
POLL_SECONDS=1.0
DB_PATH=luckyjet_2x_push.sqlite3

# Apple Developer → Keys → APNs key (.p8)
APNS_TEAM_ID=REPLACE_ME
APNS_KEY_ID=REPLACE_ME
APNS_BUNDLE_ID=com.miuiproking.luckyjet2x
APNS_P8_PATH=/absolute/path/AuthKey_REPLACE_ME.p8
APNS_USE_SANDBOX=false

# Copy the 64-character token from the app's bell button.
# Multiple iPhones: comma-separated tokens.
APNS_DEVICE_TOKENS=

# Optional when the app registers itself through a public HTTPS /register URL.
REGISTRATION_SECRET=

